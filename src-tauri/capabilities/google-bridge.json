{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "google-chat-bridge",
  "local": false,
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://chat.google.com/*",
      "https://mail.google.com/*"
    ]
  },
  "permissions": [
    "allow-show-windows-toast",
    "allow-set-unread-count",
    "allow-is-main-window-visible",
    "allow-open-url"
  ]
}
