{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Google Chat",
  "mainBinaryName": "Google Chat",
  "version": "0.0.17",
  "identifier": "io.github.thatonecalculator.google-chat-tauri",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "devUrl": "http://localhost:1422",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "icons/Square30x30Logo.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "minimumWebview2Version": "156.0.0.0",
      "wix": {
        "upgradeCode": "7cd5b23c-b4f4-522f-b545-51264ed6f0ba",
        "template": "wix/upgrade.wxs"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "google-chat"
        ]
      }
    }
  }
}
